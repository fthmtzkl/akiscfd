// __TURBULENCE_MODEL__ is replaced at runtime: kOmegaSST or kEpsilon

simulationType  RAS;

RAS
{
    RASModel        __TURBULENCE_MODEL__;

    turbulence      on;
    printCoeffs     on;
}

