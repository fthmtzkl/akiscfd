turbulentOmega  __OMEGA_VALUE__;

// Turbulent dissipation rate [m²/s³]  (k-epsilon)
turbulentEpsilon __EPSILON_VALUE__;

// Turbulent viscosity [m²/s]
turbulentNu     1e-03;

