# AkisCFD — Production environment variables
# Copy to .env.prod and fill in values (never commit .env.prod)

# Generate with: openssl rand -hex 32
SECRET_KEY=CHANGE_THIS_TO_A_RANDOM_64_CHAR_STRING

# Comma-separated allowed origins
CORS_ORIGINS=https://akiscfd.com,https://www.akiscfd.com

# Celery Flower monitoring UI auth (user:password)
FLOWER_AUTH=admin:CHANGE_THIS_PASSWORD

# Docker image tag (set by CI/CD, or use 'latest')
IMAGE_TAG=latest
