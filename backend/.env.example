# AkisCFD – Backend environment variables
# Copy to .env and fill in your values

# Debug mode (true / false)
DEBUG=false

# File storage paths (local dev: /tmp, Docker: /data/...)
UPLOAD_DIR=/tmp/cfd_uploads
SIMULATIONS_DIR=/tmp/cfd_simulations

# Redis (required for job persistence; optional – falls back to in-memory)
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# OpenFOAM (only needed when running real simulations; mock mode works without it)
OPENFOAM_VERSION=v2312
OPENFOAM_DIR=/usr/lib/openfoam/openfoam2312
OPENFOAM_BASHRC=/usr/lib/openfoam/openfoam2312/etc/bashrc

# Limits
MAX_UPLOAD_SIZE_MB=100
MAX_CONCURRENT_JOBS=4
JOB_TIMEOUT_SECONDS=3600

# CORS – comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
